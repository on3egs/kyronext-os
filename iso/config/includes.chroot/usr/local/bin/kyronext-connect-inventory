#!/usr/bin/python3
"""Inventaire de cette machine seulement ; aucune découverte ni commande distante."""
import argparse
from datetime import datetime, timezone
import ipaddress
import json
import os
from pathlib import Path
import platform
import socket
import struct


def read_optional(path, limit=4096):
    try:
        with Path(path).open('r', encoding='utf-8', errors='replace') as stream:
            return stream.read(limit).strip().strip('\x00')
    except OSError:
        return None


def interface_addresses(name):
    addresses = []
    # ioctl lit la configuration locale ; aucun paquet n'est envoyé.
    try:
        import fcntl
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as handle:
            response = fcntl.ioctl(handle.fileno(), 0x8915, struct.pack('256s', name.encode()[:15]))
            addresses.append(str(ipaddress.IPv4Address(response[20:24])))
    except (ImportError, OSError, ValueError):
        pass
    try:
        for line in Path('/proc/net/if_inet6').read_text().splitlines():
            fields = line.split()
            if len(fields) == 6 and fields[5] == name:
                addresses.append(str(ipaddress.IPv6Address(int(fields[0], 16))))
    except (OSError, ValueError):
        pass
    return addresses


def inventory():
    interfaces = []
    network = Path('/sys/class/net')
    if network.is_dir():
        for interface in sorted(network.iterdir()):
            if interface.name == 'lo':
                continue
            interfaces.append({'name': interface.name,
                               'state': read_optional(interface / 'operstate'),
                               'local_addresses': interface_addresses(interface.name)})
    model = (read_optional('/proc/device-tree/model') or
             read_optional('/sys/devices/virtual/dmi/id/product_name'))
    return {'schema_version': 1, 'generated_at': datetime.now(timezone.utc).isoformat(),
            'local_only': True, 'discovery_enabled': False,
            'remote_control_enabled': False, 'pairing_required': True,
            'device': {'hostname': socket.gethostname(), 'platform': platform.system(),
                       'kernel': platform.release(), 'architecture': platform.machine(),
                       'model': model, 'compatibility': 'unverified',
                       'interfaces': interfaces, 'authorized_remote_services': []},
            'notice': 'Inventaire local. Aucune autre machine découverte, vérifiée ou autorisée.'}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, help='Créer un nouveau rapport JSON privé, sans écraser un fichier existant')
    args = parser.parse_args()
    content = json.dumps(inventory(), ensure_ascii=False, indent=2) + '\n'
    if args.output:
        descriptor = os.open(args.output, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
            stream.write(content)
    else:
        print(content, end='')


if __name__ == '__main__':
    main()
